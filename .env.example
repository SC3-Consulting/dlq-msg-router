# Azure Service Bus Configuration
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE="<namespace>.servicebus.windows.net"
TARGET_QUEUE_NAME="viva-integration-queue"
PARKING_LOT_QUEUE_NAME="parking-lot-queue"

# AI/LLM Integration (Ollama)
OLLAMA_ENDPOINT="http://localhost:11434/api/generate"
OLLAMA_MODEL="llama3.2:latest"

# Pipeline Configuration
RULES_FILE_PATH="data/rules.json"