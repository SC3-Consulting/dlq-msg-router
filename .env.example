# Azure Service Bus Configuration
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE="your-namespace-here.servicebus.windows.net"
# Optional local fallback auth for Docker/local testing (overrides Entra auth path when provided)
# SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

# Azure Credentials (Optional for local testing only; production should use Managed Identity)
# AZURE_TENANT_ID="your-tenant-id"
# AZURE_CLIENT_ID="your-client-id"



# Toggle for RBAC-secured dynamic discovery of queues
ENABLE_DYNAMIC_DISCOVERY="True"
# Comma-separated list of queues to ignore during dynamic discovery
EXCLUDED_QUEUES="system-queue,archive-queue"

# Fallback JSON Array if Dynamic Discovery is disabled or hits an RBAC 403 error
ASB_SOURCES_FILE="data/asb_sources.json"
PARKING_LOT_QUEUE_NAME="your-parking-lot-queue"

# Optional Azure Service Bus emulator controls (opt-in)
# To enable: run docker compose with --profile asb-emulator and set ACCEPT_EULA="Y".
# The emulator stack includes SQL Server and can spike CPU, RAM, and local disk during startup.
# In devcontainer / Docker-on-WSL sessions, prefer a low-footprint local profile when stability matters:
#   OLLAMA_MODEL="qwen2.5:0.5b"
#   MAX_CONCURRENT_QUEUES=1
#   PREFETCH_COUNT=1
#   AGENT_CYCLE_SLEEP_SECONDS=30
EMULATOR_HTTP_PORT=5300
ACCEPT_EULA="N"
# Must satisfy SQL Server password policy when emulator profile is enabled.
MSSQL_SA_PASSWORD=""
# Local startup dependency wait (recommended when using the emulator profile)
ENABLE_DEPENDENCY_WAIT="True"
DEPENDENCY_WAIT_TIMEOUT_SECONDS=120

# Maximum number of concurrent queues processed at any given second
MAX_CONCURRENT_QUEUES=5
ASB_MAX_MESSAGE_COUNT=10
ASB_MAX_WAIT_TIME=5
# Fills local RAM buffer to eliminate network latency during batch pulls
PREFETCH_COUNT=20

# Action Execution Feature Flags
ENABLE_NEW_MESSAGE_ID_ON_RETRY="True"

# Cache & Threshold Configuration
IDEMPOTENCY_TTL_SECONDS=86400
CLASSIFICATION_TTL_SECONDS=600
MAX_RESUBMIT_COUNT=3
DUPLICATE_NOISE_THRESHOLD=10

# Storage Paths
TELEMETRY_CSV_PATH="reports/telemetry_dashboard.csv"
IDEMPOTENCY_DB_PATH="data/idempotency.db"

# AI Client Configuration
# Use qwen2.5:0.5b or llama3.2:1b for local CPU testing to avoid AMQP timeouts.
# GPU recommendation (subject to VRAM):
# - >= 8 GB VRAM:  qwen2.5:7b-instruct or llama3.1:8b-instruct-q4_K_M
# - >= 16 GB VRAM: qwen2.5:14b-instruct-q4_K_M
# Startup helper: ./scripts/ollama_model_startup_check.sh
# Note: in Docker-on-WSL setups where Ollama runs in a different runtime boundary,
# GPU/VRAM detection may be inaccurate. Override OLLAMA_MODEL manually if needed.
# Target state: llama3.2:latest (or Azure AI Foundry equivalent)
OLLAMA_MODEL="qwen2.5:0.5b"
OLLAMA_ENDPOINT="http://localhost:11434/api/generate"
# Note: Temperature is supported by Ollama but may need to be omitted for Azure Foundry compatibility
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=240
OLLAMA_NUM_CTX=4096

# File Paths
RULES_FILE_PATH="data/rules.json"

# Options: OLLAMA, AZURE_FOUNDRY
AI_PROVIDER="AZURE_FOUNDRY"

# Azure Foundry Specifics (Required if AI_PROVIDER="AZURE_FOUNDRY")
AZURE_FOUNDRY_ENDPOINT="https://privatelink.services.ai.azure.com/your-endpoint"
AZURE_FOUNDRY_DEPLOYMENT_NAME="gpt-4o-mini"
# Leave empty for strict reasoning models that do not support variable temperature
AZURE_FOUNDRY_TEMPERATURE=1
AZURE_FOUNDRY_MAX_TOKENS=1200
AZURE_FOUNDRY_EMPTY_RESPONSE_MAX_TOKENS=2400

# Time to sleep (in seconds) after completing a full sweep of all queues
# Prevents aggressive AMQP link churn if all DLQs are empty.
AGENT_CYCLE_SLEEP_SECONDS=60

